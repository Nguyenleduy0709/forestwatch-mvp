# Application reads shell environment variables; this file is a reference, NOT auto-loaded.
# PowerShell example: $env:INFERENCE_MODE = 'demo'
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a private random value before deployment; never commit it.
# DJANGO_SECRET_KEY=
TIME_ZONE=Asia/Ho_Chi_Minh
INFERENCE_MODE=demo
MODEL_CONFIDENCE=0.35
# Optional absolute paths. Defaults are backend/db.sqlite3, backend/weights/*,
# and .fosp-runtime/ relative to the repository, independent of the shell cwd.
# DATABASE_PATH=D:/ForestWatch/backend/db.sqlite3
# MEDIA_ROOT=D:/ForestWatch/backend/media
# MODEL_PATH=D:/ForestWatch/backend/weights/best.pt
# FOSP_MODEL_PATH=D:/ForestWatch/checkpoints/fosp_smoke5k_14000/best.pth
# FOSP_RUNTIME_DIR=D:/ForestWatch/outputs/forestwatch-mvp/.fosp-runtime
